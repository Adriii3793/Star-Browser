{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "star",
  "version": "0.1.0",
  "identifier": "com.studio.star",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "star",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "alwaysOnTop": false,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "main",
        "overlay-webviews"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; media-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Star Development Team",
    "copyright": "\u00a9 2026 Star Development Team",
    "category": "Productivity",
    "shortDescription": "Star \u2014 a minimalist AI browser",
    "homepage": "https://github.com/Adriii3793/Project-2k26",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": [
          "it-IT"
        ]
      },
      "nsis": {
        "languages": [
          "Italian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
